      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-ims"
          },
          "hide": false,
          "query": "warn = 0.10\r\ncrit = 0.15\r\n\r\nfrom(bucket: \"bearings\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"vibration\" and r._field == \"rms\")\r\n  |> filter(fn: (r) => contains(value: r.bearing, set: ${bearing:json}))\r\n  |> aggregateWindow(every: 15m, fn: mean, createEmpty: false)\r\n  |> map(fn: (r) => ({r with _value: if r._value > crit then 2.0 else if r._value > warn then 1.0 else 0.0}))\r\n  |> aggregateWindow(every: 30m, fn: min, createEmpty: false)\r\n  |> keep(columns: [\"_time\", \"_value\", \"bearing\"])\r\n  |> group(columns: [\"bearing\"])",
          "refId": "A"
        }
      ],
      "title": "Reporting des alertes",
      "type": "state-timeline"
    },
